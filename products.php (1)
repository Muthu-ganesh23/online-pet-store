<script>

/* =========================================
   DELETE CONFIRMATION
========================================= */

document
    .querySelectorAll(".delete-product")
    .forEach(function(button) {

        button.addEventListener(
            "click",
            function(event) {

                const confirmed =
                    window.confirm(
                        "Are you sure you want to delete this product?"
                    );


                if (!confirmed) {

                    event.preventDefault();

                }

            }
        );

    });

</script>


