<?php

require_once "../config/database.php";
require_once "../config/functions.php";

requireAdmin();


/* =========================
   DELETE PRODUCT
========================= */

if (isset($_GET["delete"])) {

    $productId = (int) $_GET["delete"];

    if ($productId > 0) {

        $stmt = $conn->prepare(
            "DELETE FROM products WHERE id = ?"
        );

        if ($stmt) {

            $stmt->bind_param(
                "i",
                $productId
            );

            if ($stmt->execute()) {

                setMessage(
                    "Product deleted successfully!",
                    "success"
                );

            } else {

                setMessage(
                    "Unable to delete product.",
                    "error"
                );
            }

            $stmt->close();

        } else {

            setMessage(
                "Unable to delete product.",
                "error"
            );
        }
    }

    redirect("products.php");
    exit;
}


/* =========================
   SEARCH
========================= */

$search = trim(
    $_GET["search"] ?? ""
);


if ($search !== "") {

    $searchValue =
        "%" . $search . "%";


    $stmt = $conn->prepare("
        SELECT
            p.id,
            p.name,
            p.description,
            p.cost_price,
            p.selling_price,
            p.stock,
            p.image,
            p.status,
            c.name AS category_name
        FROM products p
        INNER JOIN categories c
            ON p.category_id = c.id
        WHERE
            p.name LIKE ?
            OR c.name LIKE ?
        ORDER BY p.id DESC
    ");


    $stmt->bind_param(
        "ss",
        $searchValue,
        $searchValue
    );


    $stmt->execute();


    $products =
        $stmt->get_result();


} else {


    $products = $conn->query("
        SELECT
            p.id,
            p.name,
            p.description,
            p.cost_price,
            p.selling_price,
            p.stock,
            p.image,
            p.status,
            c.name AS category_name
        FROM products p
        INNER JOIN categories c
            ON p.category_id = c.id
        ORDER BY p.id DESC
    ");
}


/* =========================
   TOTAL PRODUCT COUNT
========================= */

$countResult = $conn->query(
    "SELECT COUNT(*) AS total FROM products"
);


$totalProducts = 0;


if ($countResult) {

    $countData =
        $countResult->fetch_assoc();

    $totalProducts =
        (int) $countData["total"];
}


/* =========================
   TOTAL STOCK
========================= */

$stockResult = $conn->query("
    SELECT
        COALESCE(SUM(stock), 0) AS total_stock
    FROM products
    WHERE status = 'active'
");


$totalStock = 0;


if ($stockResult) {

    $stockData =
        $stockResult->fetch_assoc();

    $totalStock =
        (int) $stockData["total_stock"];
}


/* =========================
   LOW STOCK COUNT
========================= */

$lowStockResult = $conn->query("
    SELECT
        COUNT(*) AS total
    FROM products
    WHERE status = 'active'
      AND stock <= 5
");


$lowStockCount = 0;


if ($lowStockResult) {

    $lowStockData =
        $lowStockResult->fetch_assoc();

    $lowStockCount =
        (int) $lowStockData["total"];
}

