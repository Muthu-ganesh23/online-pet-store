require_once "../config/database.php";
require_once "../config/functions.php";

requireAdmin();

/* ==========================================
   DELETE FEEDBACK
========================================== */

if ($_SERVER["REQUEST_METHOD"] === "POST") {

    $feedbackId = isset($_POST["feedback_id"])
        ? (int)$_POST["feedback_id"]
        : 0;

    if ($feedbackId <= 0) {

        setMessage(
            "Invalid feedback ID.",
            "error"
        );

        redirect("feedback.php");
    }

    $stmt = $conn->prepare("
        DELETE FROM feedback
        WHERE id = ?
    ");

    $stmt->bind_param(
        "i",
        $feedbackId
    );

    if ($stmt->execute()) {

        setMessage(
            "Feedback deleted successfully.",
            "success"
        );

    } else {

        setMessage(
            "Feedback could not be deleted.",
            "error"
        );
    }

    redirect("feedback.php");
}


/* ==========================================
   SEARCH / FILTER
========================================== */

$search = isset($_GET["search"])
    ? trim($_GET["search"])
    : "";

$ratingFilter = isset($_GET["rating"])
    ? (int)$_GET["rating"]
    : 0;


/* ==========================================
   FEEDBACK QUERY
========================================== */

$sql = "
    SELECT
        f.id,
        f.rating,
        f.comment,
        f.created_at,

        u.name AS user_name,
        u.email AS user_email,

        p.name AS product_name,
        p.image AS product_image

    FROM feedback f

    INNER JOIN users u
        ON f.user_id = u.id

    INNER JOIN products p
        ON f.product_id = p.id

    WHERE 1=1
";

$params = [];
$types = "";


/* Search */

if ($search !== "") {

    $sql .= "
        AND (
            u.name LIKE ?
            OR u.email LIKE ?
            OR p.name LIKE ?
            OR f.comment LIKE ?
        )
    ";

    $searchLike =
        "%" . $search . "%";

    $params[] = $searchLike;
    $params[] = $searchLike;
    $params[] = $searchLike;
    $params[] = $searchLike;

    $types .= "ssss";
}


/* Rating */

if ($ratingFilter >= 1 && $ratingFilter <= 5) {

    $sql .= "
        AND f.rating = ?
    ";

    $params[] = $ratingFilter;

    $types .= "i";
}


$sql .= "
    ORDER BY f.created_at DESC
";


$stmt = $conn->prepare($sql);

if (!empty($params)) {

    $stmt->bind_param(
        $types,
        ...$params
    );
}

$stmt->execute();

$feedbacks =
    $stmt->get_result();


/* ==========================================
   FEEDBACK SUMMARY
========================================== */

$totalFeedback = 0;
$averageRating = 0;
$fiveStar = 0;
$fourStar = 0;
$threeStar = 0;
$twoStar = 0;
$oneStar = 0;

$summaryResult = $conn->query("
    SELECT
        COUNT(*) AS total_feedback,
        COALESCE(AVG(rating), 0) AS average_rating,

        SUM(
            CASE
                WHEN rating = 5
                THEN 1 ELSE 0
            END
        ) AS five_star,

        SUM(
            CASE
                WHEN rating = 4
                THEN 1 ELSE 0
            END
        ) AS four_star,

        SUM(
            CASE
                WHEN rating = 3
                THEN 1 ELSE 0
            END
        ) AS three_star,

        SUM(
            CASE
                WHEN rating = 2
                THEN 1 ELSE 0
            END
        ) AS two_star,

        SUM(
            CASE
                WHEN rating = 1
                THEN 1 ELSE 0
            END
        ) AS one_star

    FROM feedback
");

if ($summaryResult) {

    $summary =
        $summaryResult->fetch_assoc();

    $totalFeedback =
        (int)$summary["total_feedback"];

    $averageRating =
        (float)$summary["average_rating"];

    $fiveStar =
        (int)$summary["five_star"];

    $fourStar =
        (int)$summary["four_star"];

    $threeStar =
        (int)$summary["three_star"];

    $twoStar =
        (int)$summary["two_star"];

    $oneStar =
        (int)$summary["one_star"];
}

