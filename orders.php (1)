/* ==========================================
   UPDATE ORDER STATUS
========================================== */

if ($_SERVER["REQUEST_METHOD"] === "POST") {

    $orderId = isset($_POST["order_id"])
        ? (int)$_POST["order_id"]
        : 0;

    $orderStatus = isset($_POST["order_status"])
        ? trim($_POST["order_status"])
        : "";

    $allowedStatuses = [
        "Pending",
        "Confirmed",
        "Processing",
        "Shipped",
        "Delivered",
        "Cancelled"
    ];

    if ($orderId <= 0 || !in_array($orderStatus, $allowedStatuses, true)) {

        setMessage(
            "Invalid order status.",
            "error"
        );

        redirect("orders.php");
    }

    /*
       Get current status before updating.
       This helps restore stock if an order
       is changed to Cancelled.
    */

    $checkStmt = $conn->prepare("
        SELECT order_status
        FROM orders
        WHERE id = ?
        LIMIT 1
    ");

    $checkStmt->bind_param(
        "i",
        $orderId
    );

    $checkStmt->execute();

    $checkResult = $checkStmt->get_result();
    $currentOrder = $checkResult->fetch_assoc();

    if (!$currentOrder) {

        setMessage(
            "Order not found.",
            "error"
        );

        redirect("orders.php");
    }

    $oldStatus = $currentOrder["order_status"];

    /*
       Prevent changing Cancelled order
       back to another status.
    */

    if ($oldStatus === "Cancelled" && $orderStatus !== "Cancelled") {

        setMessage(
            "A cancelled order cannot be reopened.",
            "error"
        );

        redirect("orders.php");
    }

    /*
       Start transaction when cancellation
       may require stock restoration.
    */

    $conn->begin_transaction();

    try {

        /* --------------------------------------
           UPDATE ORDER STATUS
        -------------------------------------- */

        $updateStmt = $conn->prepare("
            UPDATE orders
            SET order_status = ?
            WHERE id = ?
        ");

        $updateStmt->bind_param(
            "si",
            $orderStatus,
            $orderId
        );

        if (!$updateStmt->execute()) {
            throw new Exception(
                "Order status update failed."
            );
        }

        /*
           If order becomes Cancelled for
           the first time, restore stock.
        */

        if (
            $orderStatus === "Cancelled" &&
            $oldStatus !== "Cancelled"
        ) {

            $itemsStmt = $conn->prepare("
                SELECT product_id, quantity
                FROM order_items
                WHERE order_id = ?
            ");

            $itemsStmt->bind_param(
                "i",
                $orderId
            );

            $itemsStmt->execute();

            $itemsResult = $itemsStmt->get_result();

            while ($item = $itemsResult->fetch_assoc()) {

                $productId = (int)$item["product_id"];
                $quantity = (int)$item["quantity"];

                $stockStmt = $conn->prepare("
                    UPDATE products
                    SET stock = stock + ?
                    WHERE id = ?
                ");

                $stockStmt->bind_param(
                    "ii",
                    $quantity,
                    $productId
                );

                if (!$stockStmt->execute()) {
                    throw new Exception(
                        "Stock restoration failed."
                    );
                }
            }
        }

        $conn->commit();

        setMessage(
            "Order #".$orderId." status updated successfully.",
            "success"
        );

    } catch (Exception $e) {

        $conn->rollback();

        setMessage(
            "Order update failed. Please try again.",
            "error"
        );
    }

    redirect("orders.php");
}


/* ==========================================
   SEARCH / FILTER
========================================== */

$search = isset($_GET["search"])
    ? trim($_GET["search"])
    : "";

$statusFilter = isset($_GET["status"])
    ? trim($_GET["status"])
    : "";

$allowedStatuses = [
    "Pending",
    "Confirmed",
    "Processing",
    "Shipped",
    "Delivered",
    "Cancelled"
];


/* ==========================================
   ORDER QUERY
========================================== */

$sql = "
    SELECT
        o.id,
        o.user_id,
        o.total_amount,
        o.payment_method,
        o.payment_status,
        o.order_status,
        o.shipping_name,
        o.shipping_phone,
        o.shipping_address,
        o.order_date,
        u.email
    FROM orders o
    INNER JOIN users u
        ON o.user_id = u.id
    WHERE 1=1
";

$params = [];
$types = "";


/* Search */

if ($search !== "") {

    $sql .= "
        AND (
            o.shipping_name LIKE ?
            OR o.shipping_phone LIKE ?
            OR u.email LIKE ?
            OR CAST(o.id AS CHAR) LIKE ?
        )
    ";

    $searchLike = "%" . $search . "%";

    $params[] = $searchLike;
    $params[] = $searchLike;
    $params[] = $searchLike;
    $params[] = $searchLike;

    $types .= "ssss";
}


/* Status */

if (
    $statusFilter !== "" &&
    in_array($statusFilter, $allowedStatuses, true)
) {

    $sql .= "
        AND o.order_status = ?
    ";

    $params[] = $statusFilter;

    $types .= "s";
}


$sql .= "
    ORDER BY o.order_date DESC
";


$stmt = $conn->prepare($sql);


/* Bind dynamic parameters */

if (!empty($params)) {

    $stmt->bind_param(
        $types,
        ...$params
    );
}

$stmt->execute();

$orders = $stmt->get_result();


/* ==========================================
   ORDER SUMMARY
========================================== */

$totalOrders = 0;
$pendingOrders = 0;
$processingOrders = 0;
$shippedOrders = 0;
$deliveredOrders = 0;
$cancelledOrders = 0;
$totalRevenue = 0;

$summaryResult = $conn->query("
    SELECT
        COUNT(*) AS total_orders,

        SUM(
            CASE
                WHEN order_status = 'Pending'
                THEN 1 ELSE 0
            END
        ) AS pending_orders,

        SUM(
            CASE
                WHEN order_status = 'Processing'
                THEN 1 ELSE 0
            END
        ) AS processing_orders,

        SUM(
            CASE
                WHEN order_status = 'Shipped'
                THEN 1 ELSE 0
            END
        ) AS shipped_orders,

        SUM(
            CASE
                WHEN order_status = 'Delivered'
                THEN 1 ELSE 0
            END
        ) AS delivered_orders,

        SUM(
            CASE
                WHEN order_status = 'Cancelled'
                THEN 1 ELSE 0
            END
        ) AS cancelled_orders,

        COALESCE(
            SUM(
                CASE
                    WHEN order_status != 'Cancelled'
                    THEN total_amount
                    ELSE 0
                END
            ),
            0
        ) AS revenue

    FROM orders
");

if ($summaryResult) {

    $summary = $summaryResult->fetch_assoc();

    $totalOrders =
        (int)$summary["total_orders"];

    $pendingOrders =
        (int)$summary["pending_orders"];

    $processingOrders =
        (int)$summary["processing_orders"];

    $shippedOrders =
        (int)$summary["shipped_orders"];

    $deliveredOrders =
        (int)$summary["delivered_orders"];

    $cancelledOrders =
        (int)$summary["cancelled_orders"];

    $totalRevenue =
        (float)$summary["revenue"];
}


/* ==========================================
   FETCH ITEMS FOR EACH ORDER
========================================== */

function getOrderItems($conn, $orderId)
{
    $stmt = $conn->prepare("
        SELECT
            product_name,
            quantity,
            selling_price,
            subtotal
        FROM order_items
        WHERE order_id = ?
        ORDER BY id ASC
    ");

    $stmt->bind_param(
        "i",
        $orderId
    );

    $stmt->execute();

    return $stmt->get_result();
}

