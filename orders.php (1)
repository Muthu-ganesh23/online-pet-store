<script>

/* ==========================================
   STATUS CONFIRMATION
========================================== */

function confirmStatusChange(form) {

    const select =
        form.querySelector(
            ".status-select"
        );

    const status =
        select.value;

    if (status === "Cancelled") {

        return confirm(
            "Are you sure you want to cancel this order? Stock will be restored."
        );
    }

    return confirm(
        "Update this order status to " +
        status +
        "?"
    );
}


/* ==========================================
   AUTO HIDE FLASH MESSAGE
========================================== */

setTimeout(function() {

    const message =
        document.querySelector(
            ".flash-message"
        );

    if (message) {

        message.style.transition =
            "opacity .5s, transform .5s";

        message.style.opacity = "0";

        message.style.transform =
            "translateY(-10px)";
    }

}, 3500);

</script>

